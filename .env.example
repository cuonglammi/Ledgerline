# Copy to .env.local for local overrides. Everything is optional in development:
# with nothing set, the app uses a local PGlite database and stores uploads in .data/uploads.

# ── Auth (Better Auth) ───────────────────────────────────────────
# Required in production. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL of the app, e.g. https://ledgerline.vercel.app (http://localhost:3000 in dev)
BETTER_AUTH_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────
# Neon connection string. Leave empty to use local PGlite (.data/pglite).
DATABASE_URL=

# ── File storage (Cloudflare R2) ─────────────────────────────────
# Leave empty to store uploads in .data/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── AI (Week 2) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
